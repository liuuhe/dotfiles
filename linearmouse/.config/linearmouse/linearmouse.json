{
  "$schema": "https://schema.linearmouse.app/0.11.4",
  "schemes": [
    {
      "if": {
        "device": {
          "category": "trackpad"
        }
      },
      "pointer": {
        "disableAcceleration": false
      },
      "scrolling": {
        "speed": {
          "vertical": 0
        }
      }
    },
    {
      "if": {
        "device": {
          "category": "mouse"
        }
      },
      "pointer": {
        "disableAcceleration": true
      },
      "scrolling": {
        "acceleration": {
          "vertical": 0
        },
        "reverse": {
          "vertical": false
        },
        "speed": {
          "vertical": 48
        }
      }
    }
  ]
}
